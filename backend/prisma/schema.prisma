datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HEAD_OF_IT
  IT_MANAGER
  IT_OFFICER
  EMPLOYEE
  VIEWER
  PORTAL_ACCESS
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  RETIRED
}

enum AssignmentType {
  EMPLOYEE
  DEPARTMENT
  LOCATION
  SHARED
  STORE
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                 String        @id @default(uuid())
  fullName           String
  email              String        @unique
  passwordHash       String
  role               Role          @default(EMPLOYEE)
  status             GeneralStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(true)
  employeeId         String?       @unique
  employee           Employee?     @relation(fields: [employeeId], references: [id])
  modulePermissions  Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  requestedTickets SupportTicket[]       @relation("RequestedTickets")
  assignedTickets  SupportTicket[]       @relation("AssignedTickets")
  assignedByTickets SupportTicket[]      @relation("AssignedByTickets")
  ticketComments   TicketComment[]
  statusHistories  TicketStatusHistory[]
  notifications    Notification[]
  portalSessions   PortalSession[]
}

model Department {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  status      GeneralStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employees      Employee[]
  assets         Asset[]
  supportTickets SupportTicket[]
}

model Location {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  status      GeneralStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employees      Employee[]
  assets         Asset[]
  supportTickets SupportTicket[]
}

model Employee {
  id           String  @id @default(uuid())
  employeeCode String  @unique
  fullName     String
  email        String?
  designation  String?
  phone        String?
  avatarUrl    String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  status    GeneralStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assignedAssets Asset[]           @relation("DirectAssignment")
  assignments    AssetAssignment[]
  supportTickets SupportTicket[]
  portalSessions PortalSession[]
  user           User?
}

model Asset {
  id                 String         @id @default(uuid())
  assetCode          String         @unique
  deviceType         String
  brand              String?
  model              String?
  serialNumber       String?        @unique
  processor          String?
  ram                String?
  storage            String?
  operatingSystem    String?
  vendor             String?
  purchaseDate       DateTime?
  warrantyStatus     String
  warrantyExpiryDate DateTime?
  condition          String
  status             AssetStatus    @default(AVAILABLE)
  assignmentType     AssignmentType @default(EMPLOYEE)

  macAddress String?
  ipAddress  String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("DirectAssignment", fields: [assignedEmployeeId], references: [id])

  qrCodeUrl       String?
  imageUrl        String?
  imageStorageKey String?
  imageFileName   String?
  imageFileSize   Int?
  imageMimeType   String?
  imageUploadedAt DateTime?
  imageUploadedBy String?
  thumbnailUrl    String?
  remarks         String?
  accessories     Json?

  // Valuation in Sri Lankan Rupees (LKR)
  purchasePrice   Float?
  estimatedValue  Float?
  valuationSource String?
  valuationDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     AssetAssignment[]
  maintenanceLogs MaintenanceLog[]
  documents       AssetDocument[]
  supportTickets  SupportTicket[]
}

model AssetAssignment {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedDate DateTime         @default(now())
  returnedDate DateTime?
  status       AssignmentStatus @default(ACTIVE)
  remarks      String?
  accessories  Json?
  returnAccessories Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceLog {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  issueDescription String
  repairAction     String?
  vendor           String?
  repairCost       Float?
  repairDate       DateTime?
  status           MaintenanceStatus @default(OPEN)
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id               String   @id @default("global")
  assetCodePrefix  String   @default("AST")
  warrantyPeriod   Int      @default(12)
  dbStorageLimitMB Int?
  customOptions    Json?
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  userName       String?
  userEmail      String?
  userRole       String?
  employeeId     String?
  employeeName   String?
  departmentName String?

  initiatedById  String?
  executedBy     String?
  activityType   String   @default("HUMAN")

  action         String
  module         String
  entityType     String?
  entityId       String?
  entityCode     String?
  description    String?

  oldValue       String?
  newValue       String?
  changedFields  String?

  status         String   @default("SUCCESS")
  severity       String   @default("INFO")
  errorMessage   String?
  ipAddress      String?
  userAgent      String?
  correlationId  String?

  createdAt      DateTime @default(now())

  @@index([entityId])
  @@index([entityCode])
  @@index([userId])
  @@index([employeeId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model AssetTimeline {
  id              String   @id @default(uuid())
  assetId         String
  assetCode       String
  eventType       String
  title           String
  description     String?
  oldStatus       String?
  newStatus       String?
  employeeId      String?
  employeeName    String?
  departmentId    String?
  departmentName  String?
  locationId      String?
  locationName    String?
  performedById   String?
  performedByName String?
  createdAt       DateTime @default(now())
}

model AssetDocument {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  documentName   String
  documentType   String
  fileUrl        String?
  storageKey     String?
  fileSize       Int
  mimeType       String?
  uploadedBy     String?
  uploadedByName String?

  createdAt DateTime @default(now())
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketRequestType {
  INCIDENT
  SERVICE_REQUEST
  INQUIRY
}

enum BusinessImpact {
  INDIVIDUAL_EMPLOYEE
  MULTIPLE_EMPLOYEES
  ENTIRE_DEPARTMENT
  ENTIRE_BRANCH
  COMPANY_WIDE
}

enum SlaStatus {
  ON_TRACK
  APPROACHING
  BREACHED
  PAUSED
  MET
}

model HelpDeskCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  examples    String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets SupportTicket[]
}

model HelpDeskSlaRule {
  id                        String         @id @default(uuid())
  priority                  TicketPriority @unique
  firstResponseMinutes      Int
  resolutionMinutes         Int
  warningThresholdPercent   Int            @default(75)
  escalateAfterBreachMinutes Int           @default(30)
  isActive                  Boolean        @default(true)
  updatedAt                 DateTime       @updatedAt
}

model HelpDeskSettings {
  id                   String   @id @default("global")
  ticketPrefix         String   @default("HD")
  ticketNumberFormat   String   @default("HD-{YYYY}-{SEQ6}")
  nextSequenceNumber   Int      @default(1)
  workingHours         Json
  holidays             Json
  allowedPauseReasons  Json
  requestTypes         Json
  priorityLevels       Json
  notificationSettings Json
  feedbackSettings     Json
  assignmentRules      Json
  escalationRules      Json
  portalConfig         Json?
  updatedAt            DateTime @updatedAt
}

model SupportTicket {
  id          String            @id @default(uuid())
  ticketCode  String            @unique
  subject     String
  description String
  priority    TicketPriority    @default(MEDIUM)
  status      TicketStatus      @default(OPEN)
  requestType TicketRequestType @default(INCIDENT)

  categoryId String?
  category   HelpDeskCategory? @relation(fields: [categoryId], references: [id])

  businessImpact        BusinessImpact @default(INDIVIDUAL_EMPLOYEE)
  businessImpactDetails String?

  requesterUserId     String?
  requesterUser       User?   @relation("RequestedTickets", fields: [requesterUserId], references: [id])
  requesterName       String?
  requesterEmployeeCode String?
  requesterEmail      String?
  contactNumber       String?
  submittedByUserId   String?
  submittedByName     String?
  submittedByRole     String?

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  assignedToId String?
  assignedTo   User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedById String?
  assignedBy   User?     @relation("AssignedByTickets", fields: [assignedById], references: [id])
  assignedAt   DateTime?

  investigationDetails       String?
  actionTaken                String?
  repairOrReplacementDetails String?
  repairCost                 Float?
  internalRemarks            String?
  pendingReason              String?

  firstResponseDueAt    DateTime?
  resolutionDueAt       DateTime?
  firstRespondedAt      DateTime?
  firstResponseMinutes  Int?
  resolutionMinutes     Int?
  slaPausedAt           DateTime?
  slaTotalPausedMinutes Int       @default(0)
  slaPauseReason        String?
  slaStatus             SlaStatus @default(ON_TRACK)
  slaBreachedAt         DateTime?
  escalatedAt           DateTime?
  approachingNotifiedAt DateTime?
  breachNotifiedAt      DateTime?

  employeeConfirmed   Boolean?
  employeeConfirmedAt DateTime?
  employeeFeedback    String?
  satisfactionRating  Int?
  employeeRemarks     String?

  resolvedAt  DateTime?
  closedAt    DateTime?
  reopenedAt  DateTime?
  reopenCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statusHistory  TicketStatusHistory[]
  comments       TicketComment[]
  attachments    TicketAttachment[]
  slaBreachLogs  SlaBreachLog[]

  @@index([status])
  @@index([priority])
  @@index([employeeId])
  @@index([requesterUserId])
  @@index([assignedToId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([assetId])
  @@index([slaStatus])
  @@index([createdAt])
}

model TicketStatusHistory {
  id            String   @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  reason        String?
  note          String?
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id])
  changedByName String?
  changedByRole String?
  createdAt     DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model TicketComment {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id])
  authorName String?
  authorRole String?
  message    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([createdAt])
}

model TicketAttachment {
  id                String         @id @default(uuid())
  ticketId          String
  ticket            SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId         String?
  comment           TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  fileName          String
  storageKey        String
  fileSize          Int
  mimeType          String?
  uploadedById      String?
  uploadedByName    String?
  isResolutionProof Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([ticketId])
}

model SlaBreachLog {
  id              String        @id @default(uuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  breachType      String
  dueAt           DateTime
  breachedAt      DateTime      @default(now())
  overdueMinutes  Int
  escalatedToId   String?
  escalatedToName String?
  createdAt       DateTime      @default(now())

  @@index([ticketId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String?
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model EmailNotificationLog {
  id             String   @id @default(uuid())
  recipientEmail String
  subject        String
  body           String
  eventType      String
  ticketId       String?
  status         String   @default("SUPPRESSED_DEV")
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model RolePermission {
  id          String   @id @default(uuid())
  role        Role     @unique
  permissions Json
  updatedAt   DateTime @updatedAt
}

model PortalSession {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalAccountId    String?
  verificationMethod String?
  rememberDevice     Boolean   @default(false)
  expiresAt          DateTime
  lastActivityAt     DateTime  @default(now())
  revokedAt          DateTime?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())

  @@index([employeeId])
  @@index([userId])
  @@index([expiresAt])
}
